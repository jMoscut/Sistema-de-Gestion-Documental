# Copiar este archivo a application-local.properties (o exportar como variables
# de entorno reales) y completar con valores propios. NUNCA commitear el archivo
# real con credenciales.

# Base de datos PostgreSQL (Neon u otro proveedor compatible)
DATABASE_URL=jdbc:postgresql://localhost:5432/sgdp_db
DATABASE_USERNAME=sgdp_app
DATABASE_PASSWORD=change_me

# JWT — string aleatorio de al menos 64 caracteres
JWT_SECRET=change-me-minimum-64-characters-long-random-string-for-jwt-signing

# Almacenamiento de archivos (Cloudflare R2 o cualquier S3-compatible, ej. MinIO en local)
R2_ACCESS_KEY=change_me
R2_SECRET_KEY=change_me
R2_BUCKET_NAME=sgdp-documentos
R2_ENDPOINT=http://localhost:9000

# Envío de correo (Brevo) — opcional en desarrollo local, vacío deshabilita el envío
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@sanraymundo.gob.gt
BREVO_SENDER_NAME=Municipalidad de San Raymundo

# URL del frontend, usada para configurar CORS
FRONTEND_URL=http://localhost:5173
